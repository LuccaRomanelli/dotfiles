defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           ldpromanelli@gmail.com
user           ldpromanelli@gmail.com
passwordeval   "bash -c 'source ~/.msmtp.env && echo $MSMTP_APP_PASSWORD'"

account default : gmail
