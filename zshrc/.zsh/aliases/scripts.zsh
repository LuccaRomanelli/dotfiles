## @cmd zet
## @desc zet <title> — create Zettelkasten note
alias zet="$HOME/shell/zet.sh"

## @cmd nn
## @desc nn <title> — create new note
alias nn="$HOME/shell/nn.sh"

## @cmd todo
## @desc Show todo list
alias todo="$HOME/shell/todo.sh"

## @cmd todoadd
## @desc todoadd "<item>" — add to todo list
alias todoadd="$HOME/shell/todoadd.sh"

## @cmd workday
## @desc Show workday log
alias workday="$HOME/shell/workday.sh"

## @cmd workdayadd
## @desc workdayadd "<entry>" — add to workday log
alias workdayadd="$HOME/shell/workdayadd.sh"
